# Copy to .env and edit locally on the server.
# RPC is optional; by default mine_submit.py uses public Ethereum RPCs.
# HASH256_RPC=https://your-private-rpc-if-needed

# For submit mode, use a fresh low-balance mining wallet.
HASH256_PRIVATE_KEY=

# No-submit mode can use HASH256_WALLET instead of a private key.
HASH256_WALLET=0x000000000000000000000000000000000000dEaD

# Safety default: false. Set true only when you want real txs.
HASH256_SUBMIT=false
HASH256_ONCE=true
HASH256_MAX_ROUNDS=0
HASH256_ROUND_SECONDS=20
# While the CUDA subprocess is running, poll live state and restart immediately
# if challenge / target(difficulty) / epoch changes.
HASH256_STATE_POLL_SECONDS=3
HASH256_RESTART_ON_STATE_CHANGE=true

# CUDA tuning
HASH256_DEVICE=0
HASH256_THREADS=128
HASH256_BLOCKS=5440
HASH256_ITERS=256
# HASH256_PREFIX=0x000102030405060708090a0b0c0d0e0f1011121314151617

# Gas / fee config
HASH256_PRIORITY_FEE_GWEI=3
# HASH256_MAX_FEE_GWEI=80
HASH256_BASE_FEE_MULTIPLIER=2
HASH256_GAS_MULTIPLIER=1.5
HASH256_MIN_GAS=200000
HASH256_MAX_GAS=400000
HASH256_FALLBACK_GAS=300000
HASH256_RECEIPT_TIMEOUT=120
